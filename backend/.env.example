# Hugging Face API token — required for AI medication extraction.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Hugging Face Inference API model for text/medication understanding.
# A lightweight text-generation model that is usually available on the free tier.
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# CORS — comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend server port (for local development).
PORT=8000
